# Jarvis — variáveis de ambiente. Copie para `.env` (ignorado pelo git) e ajuste.
# `.env` é carregado automaticamente por `pnpm dev` / `pnpm start`; variáveis já
# definidas no shell vencem o arquivo. Caminhos precisam ser absolutos (sem `~`).
# Outro arquivo: JARVIS_ENV_FILE=.env.mock (é o que `pnpm start:mock` faz).

# --- Servidor -----------------------------------------------------------------
# Porta HTTP.
PORT=4747
# Interface de escuta. Default só loopback (a API controla a máquina inteira).
# Para acessar do celular/outra máquina, use o IP do Tailscale ou 0.0.0.0 — e aí
# JARVIS_TOKEN vira obrigatório: o servidor recusa subir exposto sem token.
#JARVIS_HOST=127.0.0.1
# Toda rota /api/* passa a exigir o header `x-jarvis-token` (ou ?token=).
# Gere um: node -e 'console.log(require("crypto").randomBytes(24).toString("hex"))'
# No browser, abra uma vez http://<host>:4747/?token=<valor>; a UI guarda e some da URL.
JARVIS_TOKEN=
# Modo protótipo: só estáticos + dados fictícios de web/mock.js; API desligada.
JARVIS_MOCK=0

# --- Estado e limites -----------------------------------------------------------
# Onde o Jarvis grava sessões, cache e settings (fora do repo).
#JARVIS_DATA_DIR=/home/user/.local/state/jarvis
# Sessões que podem estar num turno ao mesmo tempo (ajustável ao vivo em settings).
JARVIS_MAX_RUNNING=2
# Quem assina aprovações de plano/gate quando o cliente não informa (default: usuário do SO).
#JARVIS_OPERATOR=user

# --- Claude Code CLI ------------------------------------------------------------
# Binário do CLI. Default: `which claude`; sem ele, o embutido no SDK.
#JARVIS_CLAUDE_BIN=/home/user/.local/bin/claude
# Home do CLI (transcripts em <dir>/projects alimentam o painel de custos).
#CLAUDE_CONFIG_DIR=/home/user/.claude

# --- Harness (kb CLI, wtree) ----------------------------------------------------
# Config do kb: projetos, grupos e vaults registrados.
#JARVIS_KB_CONFIG=/home/user/.config/kb/config.json
#JARVIS_KB_STATE_DIR=/home/user/.local/state/kb
# Onde o diálogo "novo projeto" cria repos (<dir>/<nome>).
#JARVIS_CODE_DIR=/home/user/code
# Onde ficam os worktrees, no layout do wtree (<dir>/<repo>-<branch>).
#JARVIS_WORKTREES_DIR=/home/user/code/worktrees
# Projeto registrado no kb cujos subapps são protótipos com porta fixa no script `dev`.
# Sem isso o widget de protótipos fica vazio.
#JARVIS_PROTOTYPES_PROJECT=meu-monorepo
#JARVIS_PROTOTYPES_APPS_DIR=apps

# --- Lidas, não configure -------------------------------------------------------
# HERDR_ENV=1 e HERDR_PANE_ID vêm do próprio herdr quando o Jarvis roda dentro dele.
